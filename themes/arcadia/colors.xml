<theme>
    <!-- Cloud: the default. A pale lavender ground, white cards, pastel console cards, plum text and a pink accent
         (DESIGN.md). -->
    <colorScheme name="cloud">
        <variables>
            <groundColor>f4eff8</groundColor>
            <surfaceColor>ffffff</surfaceColor>
            <raisedColor>ece4f6</raisedColor>
            <lineColor>eee7f4</lineColor>
            <textColor>3a3150</textColor>
            <mutedColor>7d7394</mutedColor>
            <faintColor>a9a0bd</faintColor>
            <accentColor>f08fae</accentColor>
            <accentTextColor>3a1f2e</accentTextColor>
            <glowTint>ffffffff</glowTint>
        </variables>
    </colorScheme>

    <!-- Dusk: the same pastels on a deep violet, for playing in the dark. -->
    <colorScheme name="dusk">
        <variables>
            <groundColor>1f1d2e</groundColor>
            <surfaceColor>2b2940</surfaceColor>
            <raisedColor>37344f</raisedColor>
            <lineColor>3a3752</lineColor>
            <textColor>f6f1fa</textColor>
            <mutedColor>bdb6d0</mutedColor>
            <faintColor>8a84a3</faintColor>
            <accentColor>f7b2c4</accentColor>
            <accentTextColor>3a1f2e</accentTextColor>
            <glowTint>ffffffcc</glowTint>
        </variables>
    </colorScheme>
</theme>
