<theme>
    <!-- Ember: the default. A warm dark ground, cream text, one amber accent (DESIGN.md). -->
    <colorScheme name="ember">
        <variables>
            <groundColor>1c1613</groundColor>
            <surfaceColor>2a211c</surfaceColor>
            <raisedColor>362a23</raisedColor>
            <lineColor>3a2e27</lineColor>
            <textColor>f7ecde</textColor>
            <mutedColor>c9b8a6</mutedColor>
            <faintColor>8a7666</faintColor>
            <accentColor>f4a259</accentColor>
            <glowTint>ffffffcc</glowTint>
        </variables>
    </colorScheme>

    <!-- Moss: the same ground with a sage accent. -->
    <colorScheme name="moss">
        <variables>
            <groundColor>1c1613</groundColor>
            <surfaceColor>2a211c</surfaceColor>
            <raisedColor>362a23</raisedColor>
            <lineColor>3a2e27</lineColor>
