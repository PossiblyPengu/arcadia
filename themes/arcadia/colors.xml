            <mutedColor>c9b8a6</mutedColor>
            <faintColor>8a7666</faintColor>
            <accentColor>a8c69f</accentColor>
            <glowTint>ffffffcc</glowTint>
        </variables>
    </colorScheme>

    <!-- Dusk: the same ground with a lavender accent. -->
