<!--
    Arcadia for ES-DE Frontend (arcadia)

    A theme with its own cozy design language, see DESIGN.md. Two views:
      system   a carousel of pastel console cards: the one you're on is large, ringed in the accent and lit by a
               soft glow in its own colour; its maker, year and game count sit below.
      gamelist a carousel of covers (or a plain list, as a variant): the selected game is large and ringed, with its
               name, a row of facts and a Play button underneath; games without art show their name on a tile.

    Console names, makers and years come from the Linear theme bundled with ES-DE (../linear-es-de/system/metadata),
    and the console pictures in the cards were drawn from its systemart (see tools/make_assets.py).
-->

<theme>
    <include>./colors.xml</include>
    <include>./../linear-es-de/system/metadata/_default.xml</include>
    <include>./../linear-es-de/system/metadata/${system.theme}.xml</include>
    <include>./assets/pastels/_default.xml</include>
    <include>./assets/pastels/${system.theme}.xml</include>

    <variables>
        <titleFont>:/fonts/Fraunces-SemiBold.ttf</titleFont>
        <labelFont>:/fonts/Nunito-ExtraBold.ttf</labelFont>
        <bodyFont>:/fonts/Nunito-Bold.ttf</bodyFont>
        <quietFont>:/fonts/Nunito-SemiBold.ttf</quietFont>
        <pixel>./assets/pixel.png</pixel>
    </variables>

    <variant name="all">
        <!-- ===== both views: ground, clock, status, button hints ===== -->
        <view name="system, gamelist">
            <image name="ground">
                <pos>0 0</pos>
                <size>1 1</size>
                <origin>0 0</origin>
                <path>${pixel}</path>
                <color>${groundColor}</color>
                <zIndex>0</zIndex>
            </image>
            <clock name="clock">
                <pos>0.966 0.07</pos>
                <origin>1 0.5</origin>
                <fontPath>${bodyFont}</fontPath>
                <fontSize>0.03</fontSize>
                <color>${mutedColor}</color>
                <format>%H:%M</format>
            </clock>
            <systemstatus name="status">
                <pos>0.895 0.07</pos>
                <origin>1 0.5</origin>
                <height>0.034</height>
                <fontPath>${bodyFont}</fontPath>
                <textRelativeScale>0.8</textRelativeScale>
                <color>${mutedColor}</color>
                <entrySpacing>0.006</entrySpacing>
            </systemstatus>
            <helpsystem name="help">
                <pos>0.034 0.962</pos>
                <origin>0 1</origin>
                <fontPath>${bodyFont}</fontPath>
                <fontSize>0.03</fontSize>
                <textColor>${mutedColor}</textColor>
                <textColorDimmed>${mutedColor}</textColorDimmed>
                <iconColor>${textColor}</iconColor>
                <iconColorDimmed>${textColor}</iconColorDimmed>
                <entrySpacing>0.016</entrySpacing>
                <iconTextSpacing>0.006</iconTextSpacing>
                <letterCase>sentence</letterCase>
            </helpsystem>
        </view>

        <!-- ===== system view: a carousel of console cards ===== -->
        <view name="system">
            <text name="wordmark">
                <pos>0.034 0.07</pos>
                <size>0.3 0.06</size>
                <origin>0 0.5</origin>
                <text>Arcadia</text>
                <fontPath>${titleFont}</fontPath>
                <fontSize>0.042</fontSize>
                <color>${textColor}</color>
                <zIndex>20</zIndex>
            </text>
            <image name="systemGlow">
                <pos>0.5 0.41</pos>
                <maxSize>0.8 0.95</maxSize>
                <origin>0.5 0.5</origin>
                <path>./assets/glow/${system.theme}.png</path>
                <default>./assets/glow/default.png</default>
                <color>${glowTint}</color>
                <interpolation>linear</interpolation>
                <zIndex>2</zIndex>
            </image>
            <carousel name="systemCarousel">
                <pos>0.5 0.41</pos>
                <size>1 0.6</size>
                <origin>0.5 0.5</origin>
                <type>horizontal</type>
                <staticImage>./assets/tiles/${system.theme}.webp</staticImage>
                <maxItemCount>5</maxItemCount>
                <itemSize>0.153 0.2775</itemSize>
                <itemScale>1.73</itemScale>
                <selectedItemMargins>0.045 0.045</selectedItemMargins>
                <itemVerticalAlignment>center</itemVerticalAlignment>
                <imageFit>contain</imageFit>
                <imageInterpolation>linear</imageInterpolation>
                <unfocusedItemOpacity>0.7</unfocusedItemOpacity>
                <unfocusedItemSaturation>0.85</unfocusedItemSaturation>
                <fastScrolling>true</fastScrolling>
                <color>00000000</color>
                <text>${system.fullName}</text>
                <textRelativeScale>0.86</textRelativeScale>
                <textColor>${textColor}</textColor>
                <textBackgroundColor>${raisedColor}</textBackgroundColor>
                <textBackgroundCornerRadius>0.013</textBackgroundCornerRadius>
                <fontPath>${titleFont}</fontPath>
                <fontSize>0.03</fontSize>
                <lineSpacing>1.1</lineSpacing>
                <letterCase>none</letterCase>
                <letterCaseAutoCollections>none</letterCaseAutoCollections>
                <letterCaseCustomCollections>none</letterCaseCustomCollections>
                <zIndex>10</zIndex>
            </carousel>
            <image name="focusRing">
                <pos>0.5 0.41</pos>
                <size>0.2936 0.526</size>
                <origin>0.5 0.5</origin>
                <path>./assets/ring.svg</path>
                <color>${accentColor}</color>
                <zIndex>12</zIndex>
            </image>
            <text name="systemFacts">
                <pos>0.5 0.765</pos>
                <size>0.8 0.04</size>
                <origin>0.5 0.5</origin>
                <text>${systemManufacturer}  ·  ${systemReleaseYear}</text>
                <fontPath>${labelFont}</fontPath>
                <fontSize>0.022</fontSize>
                <horizontalAlignment>center</horizontalAlignment>
                <color>${mutedColor}</color>
                <letterCase>uppercase</letterCase>
                <zIndex>20</zIndex>
            </text>
            <text name="gameCounter">
                <pos>0.5 0.815</pos>
                <size>0.8 0.05</size>
                <origin>0.5 0.5</origin>
                <systemdata>gamecountGames</systemdata>
                <fontPath>${bodyFont}</fontPath>
                <fontSize>0.032</fontSize>
                <horizontalAlignment>center</horizontalAlignment>
                <color>${textColor}</color>
                <letterCase>lowercase</letterCase>
                <zIndex>20</zIndex>
            </text>
        </view>

        <!-- ===== gamelist view ===== -->
        <view name="gamelist">
            <text name="systemTitle">
                <pos>0.047 0.07</pos>
                <size>0 0.06</size>
                <origin>0 0.5</origin>
                <text>${systemName}</text>
                <fontPath>${titleFont}</fontPath>
                <fontSize>0.036</fontSize>
                <color>${systemInk}</color>
                <backgroundColor>${systemPastel}</backgroundColor>
                <backgroundMargins>0.016 0.016</backgroundMargins>
                <backgroundCornerRadius>0.03</backgroundCornerRadius>
                <zIndex>60</zIndex>
            </text>
            <gamelistinfo name="gamelistInfo">
                <pos>0.79 0.07</pos>
                <size>0.3 0.04</size>
                <origin>1 0.5</origin>
                <fontPath>${bodyFont}</fontPath>
                <fontSize>0.026</fontSize>
                <horizontalAlignment>right</horizontalAlignment>
                <color>${mutedColor}</color>
                <zIndex>60</zIndex>
            </gamelistinfo>
            <image name="gameGlow">
                <pos>0.5 0.39</pos>
                <maxSize>0.75 0.95</maxSize>
                <origin>0.5 0.5</origin>
                <path>./assets/glow/${system.theme}.png</path>
                <default>./assets/glow/default.png</default>
                <color>${glowTint}</color>
                <interpolation>linear</interpolation>
                <zIndex>2</zIndex>
            </image>

            <!-- under the selected game: its name, a row of facts, and Play -->
            <text name="gameName">
                <pos>0.034 0.735</pos>
                <size>0.74 0.075</size>
                <origin>0 0.5</origin>
                <metadata>name</metadata>
                <fontPath>${titleFont}</fontPath>
                <fontSize>0.054</fontSize>
                <horizontalAlignment>left</horizontalAlignment>
                <color>${textColor}</color>
                <zIndex>30</zIndex>
            </text>
            <datetime name="releasedate">
                <pos>0.034 0.81</pos>
                <size>0.1 0.042</size>
                <origin>0 0.5</origin>
                <metadata>releasedate</metadata>
                <format>%Y</format>
                <defaultValue>Year unknown</defaultValue>
                <fontPath>${labelFont}</fontPath>
                <fontSize>0.021</fontSize>
                <horizontalAlignment>center</horizontalAlignment>
                <color>${textColor}</color>
                <backgroundColor>${surfaceColor}</backgroundColor>
                <backgroundCornerRadius>0.012</backgroundCornerRadius>
                <zIndex>30</zIndex>
            </datetime>
            <text name="genre">
                <pos>0.142 0.81</pos>
                <size>0.2 0.042</size>
                <origin>0 0.5</origin>
                <metadata>genre</metadata>
                <defaultValue>No genre yet</defaultValue>
                <fontPath>${labelFont}</fontPath>
                <fontSize>0.021</fontSize>
                <horizontalAlignment>center</horizontalAlignment>
                <color>${textColor}</color>
                <backgroundColor>${surfaceColor}</backgroundColor>
                <backgroundCornerRadius>0.012</backgroundCornerRadius>
                <zIndex>30</zIndex>
            </text>
            <text name="players">
                <pos>0.35 0.81</pos>
                <size>0.13 0.042</size>
                <origin>0 0.5</origin>
                <metadata>players</metadata>
                <defaultValue>Players unknown</defaultValue>
                <fontPath>${labelFont}</fontPath>
                <fontSize>0.021</fontSize>
                <horizontalAlignment>center</horizontalAlignment>
                <color>${textColor}</color>
                <backgroundColor>${surfaceColor}</backgroundColor>
                <backgroundCornerRadius>0.012</backgroundCornerRadius>
                <zIndex>30</zIndex>
            </text>
            <datetime name="lastplayed">
                <pos>0.488 0.81</pos>
                <size>0.18 0.042</size>
                <origin>0 0.5</origin>
                <metadata>lastplayed</metadata>
                <displayRelative>true</displayRelative>
                <defaultValue>Not played yet</defaultValue>
                <fontPath>${labelFont}</fontPath>
                <fontSize>0.021</fontSize>
                <horizontalAlignment>center</horizontalAlignment>
                <color>${mutedColor}</color>
                <backgroundColor>${surfaceColor}</backgroundColor>
                <backgroundCornerRadius>0.012</backgroundCornerRadius>
                <zIndex>30</zIndex>
            </datetime>
            <text name="description">
                <pos>0.034 0.875</pos>
                <size>0.62 0.06</size>
                <origin>0 0.5</origin>
                <metadata>description</metadata>
                <container>true</container>
                <containerScrollSpeed>1</containerScrollSpeed>
                <containerStartDelay>4.5</containerStartDelay>
                <containerResetDelay>7</containerResetDelay>
                <fontPath>${quietFont}</fontPath>
                <fontSize>0.024</fontSize>
                <lineSpacing>1.2</lineSpacing>
                <horizontalAlignment>left</horizontalAlignment>
                <color>${mutedColor}</color>
                <zIndex>30</zIndex>
            </text>
            <image name="playButton">
                <pos>0.966 0.765</pos>
                <maxSize>0.16 0.08</maxSize>
                <origin>1 0.5</origin>
                <path>./assets/play-pill.svg</path>
                <color>${accentColor}</color>
                <zIndex>30</zIndex>
            </image>
            <image name="playLabel">
                <pos>0.966 0.765</pos>
                <maxSize>0.16 0.08</maxSize>
                <origin>1 0.5</origin>
                <path>./assets/play-label.svg</path>
                <color>${accentTextColor}</color>
                <zIndex>31</zIndex>
            </image>
            <badges name="badges">
                <pos>0.966 0.86</pos>
                <size>0.16 0.042</size>
                <origin>1 0.5</origin>
                <horizontalAlignment>right</horizontalAlignment>
                <direction>row</direction>
                <slots>favorite, completed, broken, altemulator</slots>
                <badgeIconColor>${mutedColor}</badgeIconColor>
                <zIndex>60</zIndex>
            </badges>
        </view>
    </variant>

    <!-- cover carousel (default) -->
    <variant name="shelf">
        <view name="gamelist">
            <carousel name="gameShelf">
                <pos>0.5 0.39</pos>
                <size>1 0.62</size>
                <origin>0.5 0.5</origin>
                <type>horizontal</type>
                <imageType>cover</imageType>
                <maxItemCount>5.4</maxItemCount>
                <itemSize>0.156 0.3333</itemSize>
                <itemScale>1.5</itemScale>
                <selectedItemMargins>0.04 0.04</selectedItemMargins>
                <itemVerticalAlignment>center</itemVerticalAlignment>
                <imageFit>cover</imageFit>
                <imageInterpolation>linear</imageInterpolation>
                <imageCornerRadius>0.0125</imageCornerRadius>
                <unfocusedItemOpacity>0.55</unfocusedItemOpacity>
                <unfocusedItemSaturation>0.7</unfocusedItemSaturation>
                <fastScrolling>true</fastScrolling>
                <color>00000000</color>
                <textRelativeScale>0.84</textRelativeScale>
                <textColor>${systemInk}</textColor>
                <textBackgroundColor>${systemPastel}</textBackgroundColor>
                <textBackgroundCornerRadius>0.0125</textBackgroundCornerRadius>
                <fontPath>${titleFont}</fontPath>
                <fontSize>0.034</fontSize>
                <lineSpacing>1.1</lineSpacing>
                <letterCase>none</letterCase>
                <zIndex>10</zIndex>
            </carousel>
            <image name="coverRing">
                <pos>0.5 0.39</pos>
                <size>0.2714 0.56</size>
                <origin>0.5 0.5</origin>
                <path>./assets/cover-ring.svg</path>
                <color>${accentColor}</color>
                <zIndex>12</zIndex>
            </image>
        </view>
    </variant>

    <!-- plain list, for big libraries -->
    <variant name="list">
        <view name="gamelist">
            <image name="listCard">
                <pos>0.034 0.13</pos>
                <size>0.5 0.55</size>
                <origin>0 0</origin>
                <path>${pixel}</path>
                <color>${surfaceColor}</color>
                <cornerRadius>0.02</cornerRadius>
                <zIndex>5</zIndex>
            </image>
            <textlist name="gamelistTextlist">
                <pos>0.046 0.145</pos>
                <size>0.476 0.52</size>
                <origin>0 0</origin>
                <selectorColor>${raisedColor}</selectorColor>
                <selectedColor>${textColor}</selectedColor>
                <primaryColor>${mutedColor}</primaryColor>
                <secondaryColor>${faintColor}</secondaryColor>
                <fontPath>${bodyFont}</fontPath>
                <fontSize>0.032</fontSize>
                <horizontalAlignment>left</horizontalAlignment>
                <horizontalMargin>0.014</horizontalMargin>
                <lineSpacing>1.75</lineSpacing>
                <letterCase>none</letterCase>
                <zIndex>20</zIndex>
            </textlist>
            <image name="gameCover">
                <pos>0.77 0.405</pos>
                <maxSize>0.34 0.55</maxSize>
                <origin>0.5 0.5</origin>
                <imageType>cover</imageType>
                <default>./assets/placeholder.png</default>
                <cornerRadius>0.016</cornerRadius>
                <interpolation>linear</interpolation>
                <zIndex>20</zIndex>
            </image>
            <image name="gameGlow">
                <pos>0.77 0.405</pos>
            </image>
        </view>
    </variant>

    <!-- 16:9 screens (a TV with the Deck docked): the same layout, with item widths kept in proportion -->
    <aspectRatio name="16:9">
        <variant name="all">
            <view name="system">
                <carousel name="systemCarousel">
                    <itemSize>0.1373 0.2775</itemSize>
                </carousel>
                <image name="focusRing">
                    <size>0.2634 0.526</size>
                </image>
            </view>
        </variant>
        <variant name="shelf">
            <view name="gamelist">
                <carousel name="gameShelf">
                    <itemSize>0.1406 0.3333</itemSize>
                </carousel>
                <image name="coverRing">
                    <size>0.2447 0.56</size>
                </image>
            </view>
        </variant>
    </aspectRatio>
</theme>
