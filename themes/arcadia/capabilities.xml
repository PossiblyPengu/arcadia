<!--
    Theme capabilities for arcadia
-->

<themeCapabilities>
    <themeName>Arcadia</themeName>

    <language>en_US</language>
    <language>en_GB</language>
    <language>bs_BA</language>
    <language>ca_ES</language>
    <language>de_DE</language>
    <language>es_ES</language>
    <language>fr_FR</language>
    <language>hr_HR</language>
    <language>it_IT</language>
    <language>nl_NL</language>
    <language>pl_PL</language>
    <language>pt_BR</language>
    <language>pt_PT</language>
    <language>ro_RO</language>
    <language>ru_RU</language>
    <language>sr_RS</language>
    <language>sv_SE</language>
    <language>vi_VN</language>
    <language>ar_SA</language>
    <language>ja_JP</language>
    <language>ko_KR</language>
    <language>zh_CN</language>
    <language>zh_TW</language>

    <aspectRatio>16:9</aspectRatio>
    <aspectRatio>16:10</aspectRatio>
    <aspectRatio>4:3</aspectRatio>
    <aspectRatio>21:9</aspectRatio>

    <colorScheme name="cloud">
        <label language="en_US">Cloud (light)</label>
        <label language="en_GB">Cloud (light)</label>
    </colorScheme>
    <colorScheme name="dusk">
        <label language="en_US">Dusk (dark)</label>
        <label language="en_GB">Dusk (dark)</label>
    </colorScheme>

    <variant name="shelf">
        <label language="en_US">Cover shelf</label>
        <label language="en_GB">Cover shelf</label>
        <selectable>true</selectable>
    </variant>
    <variant name="list">
        <label language="en_US">Plain list</label>
        <label language="en_GB">Plain list</label>
        <selectable>true</selectable>
    </variant>

    <transitions name="slide">
        <label language="en_US">Slide</label>
        <label language="en_GB">Slide</label>
        <selectable>true</selectable>
        <systemToSystem>instant</systemToSystem>
        <systemToGamelist>slide</systemToGamelist>
        <gamelistToGamelist>instant</gamelistToGamelist>
        <gamelistToSystem>slide</gamelistToSystem>
        <startupToSystem>slide</startupToSystem>
        <startupToGamelist>slide</startupToGamelist>
    </transitions>
    <transitions name="fade">
        <label language="en_US">Fade</label>
        <label language="en_GB">Fade</label>
        <selectable>true</selectable>
        <systemToSystem>instant</systemToSystem>
        <systemToGamelist>fade</systemToGamelist>
        <gamelistToGamelist>instant</gamelistToGamelist>
        <gamelistToSystem>fade</gamelistToSystem>
        <startupToSystem>fade</startupToSystem>
        <startupToGamelist>fade</startupToGamelist>
    </transitions>

    <suppressTransitionProfiles>
        <entry>builtin-instant</entry>
        <entry>builtin-slide</entry>
        <entry>builtin-fade</entry>
    </suppressTransitionProfiles>
</themeCapabilities>
